# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ORBINEX Server Configuration
PORT=3000
NODE_ENV="development"
JWT_SECRET="orbinex_production_secret_key_change_in_prod"

# Optional external PostgreSQL Database URL (defaults to built-in SQLite engine)
# DATABASE_URL="postgresql://user:password@localhost:5432/orbinex_mbccet"

